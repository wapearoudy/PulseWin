{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseWin",
  "version": "0.1.14",
  "identifier": "com.pulsewin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PulseWin",
        "width": 64,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../licenses/Pulse-Apache-2.0.txt": "licenses/Pulse-Apache-2.0.txt",
      "../licenses/NOTICE-Pulse.txt": "licenses/NOTICE-Pulse.txt",
      "../licenses/rusqlite-MIT.txt": "licenses/rusqlite-MIT.txt",
      "../licenses/zstd-rs-MIT.txt": "licenses/zstd-rs-MIT.txt",
      "../licenses/Zstandard-BSD-3-Clause.txt": "licenses/Zstandard-BSD-3-Clause.txt"
    },
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRjNDNEUyNDAxOThEMjEKUldRaGpSbEE0c1R6M0l2Mlo5b2VBVWlEdWZ4dUszWi9UK3BjSkFrbFdpL0NEWXZCaG9FZkNXdWcK",
      "endpoints": []
    }
  }
}
